
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= applicationName %> | Home</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="app-shell">

    <!-- Sidebar -->
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <!-- Main Content -->
    <div class="main-area">

      <!-- Top Navigation -->
      <%- include('partials/topbar') %>

      <main class="main-content">

        <!-- Page Header -->
        <section class="page-header">
          <div>
            <p class="label">Programming Languages Laboratory</p>
            <h1><%= applicationName %></h1>
            <p>
              Welcome to your application workspace.
              The starter application has been initialized successfully.
            </p>
          </div>
        </section>

        <!-- Application Status -->
        <section class="content-card">
          <div class="section-header">
            <div>
              <h2>Application Overview</h2>
              <p>Here are the current details of your application.</p>
            </div>

            <span class="status-badge status-completed">
              Ready
            </span>
          </div>

          <div class="dashboard-grid">

            <div class="dashboard-card">
              <p class="card-label">Current Sprint</p>
              <h3><%= currentSprint %></h3>
              <p class="card-description">
                Current development sprint
              </p>
            </div>

            <div class="dashboard-card">
              <p class="card-label">Technology</p>
              <h3><%= technology %></h3>
              <p class="card-description">
                Application technology stack
              </p>
            </div>

            <div class="dashboard-card">
              <p class="card-label">Application Version</p>
              <h3><%= applicationVersion %></h3>
              <p class="card-description">
                Current application release
              </p>
            </div>

          </div>
        </section>

        <!-- Environment Status -->
        <section class="content-card">
          <div class="section-header">
            <div>
              <h2>Environment Status</h2>
              <p>Current application initialization status.</p>
            </div>
          </div>

          <div class="status-message">
            <span class="status-indicator"></span>
            <div>
              <strong>Environment Ready</strong>
              <p>
                Your application is initialized and ready for development.
              </p>
            </div>
          </div>
        </section>

      </main>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
