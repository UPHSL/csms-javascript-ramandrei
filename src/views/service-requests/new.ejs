
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <section class="card form-card">
      <p class="label">Service Request Management</p>
      <h1>Submit Service Request</h1>
      <p>Provide the information needed to submit a new request.</p>

      <nav class="module-navigation">
        <a href="/residents">Residents</a>
        <a href="/service-requests">Service Requests</a>
      </nav>

      <% if (errorMessage) { %>
        <p class="error-message" role="alert"><%= errorMessage %></p>
      <% } %>

      <form action="/service-requests" method="POST" class="resident-form">
        <div class="form-field">
          <label for="residentId">Resident ID</label>
          <input
            id="residentId"
            name="residentId"
            type="number"
            min="1"
            step="1"
            value="<%= serviceRequest.residentId %>"
            required
          >
          <% if (errors.includes("residentId")) { %>
            <p class="field-error">
              Enter a valid positive Resident ID.
            </p>
          <% } %>
          <p class="help-text">
            Enter the ID of an existing Active Resident.
          </p>
          <a href="/residents">View Residents</a>
        </div>

        <div class="form-field">
          <label for="serviceType">Service Type</label>
          <input
            id="serviceType"
            name="serviceType"
            type="text"
            value="<%= serviceRequest.serviceType %>"
            placeholder="Example: Barangay Clearance"
            required
          >
          <% if (errors.includes("serviceType")) { %>
            <p class="field-error">
              Service type is required.
            </p>
          <% } %>
        </div>

        <div class="form-field">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="5"
            placeholder="Describe the requested service."
            required
          ><%= serviceRequest.description %></textarea>
          <% if (errors.includes("description")) { %>
            <p class="field-error">
              Description is required.
            </p>
          <% } %>
        </div>

        <div class="form-field">
          <label for="dateRequested">Date Requested</label>
          <input
            id="dateRequested"
            name="dateRequested"
            type="date"
            value="<%= serviceRequest.dateRequested %>"
            required
          >
          <% if (errors.includes("dateRequested")) { %>
            <p class="field-error">
              Enter a valid requested date.
            </p>
          <% } %>
        </div>

        <p class="help-text">
          New Service Requests are automatically assigned Pending status.
        </p>

        <div class="form-actions">
          <button type="submit">Submit Service Request</button>
          <a class="button-link secondary" href="/service-requests">
            Cancel
          </a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>

