
<%
  const activePage = 'service-requests';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { activePage: 'service-requests' }) %>
    <main class="main-area">
      <%- include('../partials/topbar') %>

      <div class="main-content">
        <section class="page-header">
          <div>
            <span class="eyebrow">COMMUNITY SERVICES</span>
            <h1>New Service Request</h1>
            <p>Record a new service request submitted by a resident.</p>
          </div>
          <a href="/service-requests" class="button button-secondary">← Back to Requests</a>
        </section>

        <% if (errorMessage) { %>
          <div class="error-message"><%= errorMessage %></div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
  <div class="error-message">
    <ul>
      <% errors.forEach((error) => { %>
        <li>
          <%= typeof error === 'string'
            ? error
            : error.message || error.error || '' %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

        <section class="form-card">
          <div class="form-card-heading">
            <div>
              <h2>Request Information</h2>
              <p>Provide the resident and service details below.</p>
            </div>
          </div>

          <form action="/service-requests" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label for="residentId">Resident ID <span class="required">*</span></label>
                <input
                  id="residentId"
                  name="residentId"
                  type="number"
                  min="1"
                  value="<%= serviceRequest?.residentId || '' %>"
                  placeholder="Enter resident ID"
                  required
                >
                <span class="field-hint">Enter the ID of the resident submitting the request.</span>
              </div>

              <div class="form-group">
                <label for="serviceType">Service Type <span class="required">*</span></label>
                <input
                  id="serviceType"
                  name="serviceType"
                  type="text"
                  value="<%= serviceRequest?.serviceType || '' %>"
                  placeholder="e.g. Barangay Clearance"
                  required
                >
              </div>

              <div class="form-group form-group-full">
                <label for="description">Request Description <span class="required">*</span></label>
                <textarea
                  id="description"
                  name="description"
                  rows="5"
                  placeholder="Describe the resident's request..."
                  required
                ><%= serviceRequest?.description || '' %></textarea>
              </div>

              <div class="form-group">
                <label for="dateRequested">Date Requested <span class="required">*</span></label>
                <input
                  id="dateRequested"
                  name="dateRequested"
                  type="date"
                  value="<%= serviceRequest?.dateRequested || '' %>"
                  required
                >
              </div>
            </div>

            <p class="field-hint">New Service Requests are automatically assigned Pending status.</p>

            <div class="form-actions">
              <a href="/service-requests" class="button button-secondary">Cancel</a>
              <button type="submit" class="button button-primary">Submit Request</button>
            </div>
          </form>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
