
<%
  const activePage = 'service-requests';
  const isTerminal = serviceRequest.status === 'Completed' || serviceRequest.status === 'Cancelled';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { activePage: 'service-requests' }) %>
    <main class="main-area">
      <%- include('../partials/topbar') %>

      <div class="main-content">
        <section class="page-header">
          <div>
            <span class="eyebrow">REQUEST MANAGEMENT</span>
            <h1>Request Details</h1>
            <p>Review the submitted request and update its progress.</p>
          </div>
          <a href="/service-requests" class="button button-secondary">← Back to Requests</a>
        </section>

        <% if (noticeMessage) { %>
          <div class="notice-message"><%= noticeMessage %></div>
        <% } %>

        <section class="content-card request-detail-card">
          <div class="detail-heading">
            <div>
              <span class="detail-overline">SERVICE REQUEST</span>
              <h2>Request #<%= serviceRequest.id %></h2>
            </div>
            <span class="status-badge status-<%= serviceRequest.status.toLowerCase().replaceAll(' ', '-') %>">
              <%= serviceRequest.status %>
            </span>
          </div>

          <div class="detail-grid">
            <div class="detail-item">
              <span class="detail-label">Resident ID</span>
              <strong><%= serviceRequest.residentId %></strong>
            </div>

            <div class="detail-item">
              <span class="detail-label">Service Type</span>
              <strong><%= serviceRequest.serviceType %></strong>
            </div>

            <div class="detail-item">
              <span class="detail-label">Date Requested</span>
              <strong><%= serviceRequest.dateRequested %></strong>
            </div>

            <div class="detail-item">
              <span class="detail-label">Current Status</span>
              <strong><%= serviceRequest.status %></strong>
            </div>

            <div class="detail-item detail-item-full">
              <span class="detail-label">Request Description</span>
              <p class="detail-description"><%= serviceRequest.description %></p>
            </div>
          </div>

          <div class="workflow-section">
            <div>
              <h3>Request Workflow</h3>
              <p>Choose the appropriate action based on the current request status.</p>
            </div>

            <div class="workflow-actions">
              <% if (serviceRequest.status === 'Pending') { %>
                <form action="/service-requests/<%= serviceRequest.id %>/start-processing" method="POST">
                  <button type="submit" class="button button-primary">Start Processing</button>
                </form>
              <% } %>

              <% if (serviceRequest.status === 'In Progress') { %>
                <form action="/service-requests/<%= serviceRequest.id %>/complete" method="POST">
                  <button type="submit" class="button button-success">Mark as Completed</button>
                </form>
              <% } %>

              <% if (serviceRequest.status === 'Pending' || serviceRequest.status === 'In Progress') { %>
                <form
                  action="/service-requests/<%= serviceRequest.id %>/cancel"
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to cancel this service request?');"
                >
                  <button type="submit" class="button button-danger">Cancel Request</button>
                </form>
              <% } %>

              <% if (isTerminal) { %>
                <span class="workflow-final-message">
                  No further workflow actions. This request has reached its final status.
                </span>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
