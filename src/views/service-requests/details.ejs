
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <section class="card form-card">
      <p class="label">Service Request Management</p>
      <h1>Service Request Details</h1>

      <nav class="module-navigation">
        <a href="/residents">Residents</a>
        <a href="/service-requests">Service Requests</a>
      </nav>

      <% if (noticeMessage) { %>
        <p class="notice" role="status"><%= noticeMessage %></p>
      <% } %>

      <div class="record-details">
        <p>
          <strong>Service Request ID:</strong>
          <%= serviceRequest.id %>
        </p>

        <p>
          <strong>Resident ID:</strong>
          <%= serviceRequest.residentId %>
        </p>

        <p>
          <strong>Service Type:</strong>
          <%= serviceRequest.serviceType %>
        </p>

        <div>
          <strong>Description:</strong>
          <p><%= serviceRequest.description %></p>
        </div>

        <p>
          <strong>Date Requested:</strong>
          <%= serviceRequest.dateRequested %>
        </p>

        <p>
          <strong>Status:</strong>
          <span class="status-badge status-<%= serviceRequest.status.toLowerCase().replaceAll(' ', '-') %>">
            <%= serviceRequest.status %>
          </span>
        </p>
      </div>

      <h2>Workflow Actions</h2>

      <div class="form-actions">
        <% if (serviceRequest.status === "Pending") { %>
          <form
            action="/service-requests/<%= serviceRequest.id %>/start-processing"
            method="POST"
          >
            <button type="submit">Start Processing</button>
          </form>

          <form
            action="/service-requests/<%= serviceRequest.id %>/cancel"
            method="POST"
            onsubmit="return confirm('Cancel this Service Request?');"
          >
            <button class="danger-button" type="submit">
              Cancel Request
            </button>
          </form>

        <% } else if (serviceRequest.status === "In Progress") { %>
          <form
            action="/service-requests/<%= serviceRequest.id %>/complete"
            method="POST"
          >
            <button type="submit">Complete Request</button>
          </form>

          <form
            action="/service-requests/<%= serviceRequest.id %>/cancel"
            method="POST"
            onsubmit="return confirm('Cancel this Service Request?');"
          >
            <button class="danger-button" type="submit">
              Cancel Request
            </button>
          </form>

        <% } else if (serviceRequest.status === "Completed") { %>
          <p class="empty-state">
            This Service Request is completed. No further workflow actions are available.
          </p>

        <% } else if (serviceRequest.status === "Cancelled") { %>
          <p class="empty-state">
            This Service Request is cancelled. No further workflow actions are available.
          </p>
        <% } %>
      </div>

      <p class="back-link">
        <a href="/service-requests">Back to Service Request Management</a>
      </p>
    </section>
  </main>
</body>
</html>
