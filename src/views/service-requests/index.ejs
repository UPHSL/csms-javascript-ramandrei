
<%
  const activePage = 'service-requests';

  const sortedServiceRequests = [...(serviceRequests || [])].sort((a, b) =>
    String(b.dateRequested).localeCompare(String(a.dateRequested)) ||
    Number(b.id) - Number(a.id)
  );
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { activePage: 'service-requests' }) %>
    <main class="main-area">
      <%- include('../partials/topbar') %>

      <div class="main-content">
        <section class="page-header">
          <div>
            <span class="eyebrow">COMMUNITY SERVICES</span>
            <h1>Service Requests</h1>
            <p>Track, review, and manage community service requests.</p>
          </div>
          <a href="/service-requests/new" class="button button-primary">+ New Request</a>
        </section>

        <% if (noticeMessage) { %>
          <div class="notice-message"><%= noticeMessage %></div>
        <% } %>

        <% if (errorMessage) { %>
          <div class="error-message"><%= errorMessage %></div>
        <% } %>

        <section class="content-card">
          <div class="section-heading">
            <div>
              <h2>Request Directory</h2>
              <p>Search requests or filter them by their current status.</p>
            </div>
            <span class="record-count"><%= sortedServiceRequests.length %> records</span>
          </div>

          <form action="/service-requests" method="GET" class="filter-grid">
            <div class="form-group">
              <label for="search">Search requests</label>
              <input
                id="search"
                type="search"
                name="search"
                value="<%= searchTerm || '' %>"
                placeholder="Search by service type or description..."
              >
            </div>

            <div class="form-group">
              <label for="status">Request Status</label>
              <select id="status" name="status">
                <option value="">All Statuses</option>
                <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="In Progress" <%= selectedStatus === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                <option value="Completed" <%= selectedStatus === 'Completed' ? 'selected' : '' %>>Completed</option>
                <option value="Cancelled" <%= selectedStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>

            <div class="filter-actions">
              <button type="submit" class="button button-primary">Apply Filters</button>
              <a href="/service-requests" class="button button-secondary">Clear</a>
            </div>
          </form>

          <% if (sortedServiceRequests.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">▤</div>
              <h3>No service requests found</h3>
              <p>Try changing your search or filter, or create a new request.</p>
              <a href="/service-requests/new" class="button button-primary">Create Request</a>
            </div>
          <% } else { %>
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Request ID</th>
                    <th>Resident ID</th>
                    <th>Service Type</th>
                    <th>Date Requested</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% sortedServiceRequests.forEach((request) => { %>
                    <tr>
                      <td><%= request.id %></td>
                      <td><%= request.residentId %></td>
                      <td><%= request.serviceType %></td>
                      <td><%= request.dateRequested %></td>
                      <td>
                        <span class="status-badge status-<%= request.status.toLowerCase().replaceAll(' ', '-') %>">
                          <%= request.status %>
                        </span>
                      </td>
                      <td>
                        <a href="/service-requests/<%= request.id %>" class="button button-small button-secondary">
                          View Details
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
